<Layouts.app flash={@flash} current_scope={@current_scope} current_journal={@current_journal} user_journals={@user_journals}>
  <div class="max-w-full mx-auto px-6 py-8">
    <div class="bg-white border-x border-gray-200 p-8">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Users Management</h1>
          <p class="text-sm text-gray-700 mt-1">Manage user accounts, roles, and permissions</p>
        </div>
        
        <div class="flex gap-3">
          <button 
            phx-click="export_csv"
            class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded border border-gray-400 shadow-sm transition-colors"
          >
            Export CSV
          </button>
        </div>
      </div>

      <!-- Search & Filters -->
      <div class="bg-gray-50 rounded-lg p-4 mb-6 border border-gray-200">
        <.form for={@filter_form} phx-change="search" phx-submit="search" class="grid grid-cols-1 md:grid-cols-5 gap-4">
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
            <.input 
              field={@filter_form[:search]} 
              type="text" 
              placeholder="Search by email or username..."
              class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-[#1b629b]"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
            <.input 
              field={@filter_form[:role_id]} 
              type="select" 
              options={[{nil, "All Roles"} | @roles_list]}
              class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-[#1b629b]"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Journal</label>
            <.input 
              field={@filter_form[:journal_id]} 
              type="select" 
              options={[{nil, "All Journals"} | Enum.map(@journals, &{&1.path, &1.journal_id})]}
              class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-[#1b629b]"
            />
          </div>

          <div class="flex items-end">
            <label class="flex items-center gap-2 cursor-pointer">
              <.input field={@filter_form[:disabled]} type="checkbox" class="h-4 w-4 rounded border-gray-300 text-[#1b629b] focus:ring-0" />
              <span class="text-sm text-gray-700">Disabled only</span>
            </label>
          </div>
        </.form>
      </div>

      <!-- Users Table -->
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Journals</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Registered</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= for user <- @users do %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= user.username %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-700"><%= user.email %></td>
                <td class="px-6 py-4">
                  <div class="flex flex-wrap gap-1">
                    <%= for role <- user.roles do %>
                      <span class="px-2 py-0.5 text-xs bg-blue-50 text-blue-700 rounded-full">
                        <%= role.role_name %> @ <%= role.journal_path %>
                      </span>
                    <% end %>
                    <%= if user.roles == [] do %>
                      <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full">No roles</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-wrap gap-1">
                    <%= for journal <- user.journals do %>
                      <span class="px-2 py-0.5 text-xs bg-green-50 text-green-700 rounded-full">
                        <%= journal.path %>
                      </span>
                    <% end %>
                    <%= if user.journals == [] do %>
                      <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-full">None</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= if user.disabled == 1 do %>
                    <span class="px-2 py-1 text-xs bg-red-50 text-red-700 rounded-full">Disabled</span>
                  <% else %>
                    <span class="px-2 py-1 text-xs bg-green-50 text-green-700 rounded-full">Active</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= user.date_registered %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                  <button 
                    phx-click="toggle_user" 
                    phx-value-user_id={user.user_id}
                    phx-value-action={if user.disabled == 1, do: "approve", else: "reject"}
                    class={if user.disabled == 1, do: "text-green-600 hover:text-green-800", else: "text-red-600 hover:text-red-800"}>
                    <%= if user.disabled == 1, do: "Approve", else: "Disable" %>
                  </button>
                  
                  <button 
                    phx-click="edit_roles"
                    phx-value-user_id={user.user_id}
                    class="text-blue-600 hover:text-blue-800">
                    Roles
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <%= if @pagination.total_pages > 1 do %>
        <div class="mt-6 flex justify-center">
          <nav class="flex items-center space-x-2">
            <%= if @pagination.page > 1 do %>
              <a href={~p"/admin/users?#{URI.encode_query(@filters |> Map.put(:page, @pagination.page - 1))}" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-50">Previous</a>
            <% end %>
            
            <span class="px-3 py-1 text-sm text-gray-700">
              Page <%= @pagination.page %> of <%= @pagination.total_pages %>
            </span>
            
            <%= if @pagination.page < @pagination.total_pages do %>
              <a href={~p"/admin/users?#{URI.encode_query(@filters |> Map.put(:page, @pagination.page + 1))}" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-50">Next</a>
            <% end %>
          </nav>
        </div>
      <% end %>

      <!-- Roles Modal -->
      <%= if @show_roles_modal do %>
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" phx-click="close_modal">
          <div class="bg-white rounded-lg p-6 w-full max-w-md mx-4" phx-click-away="close_modal">
            <h2 class="text-xl font-bold mb-4">Edit Roles for <%= @modal_user.username %></h2>
            
            <.form for={@roles_form} phx-submit="save_roles" phx-change="save_roles" class="space-y-4">
              <input type="hidden" name="user_id" value={@modal_user.user_id} />
              
              <div class="max-h-64 overflow-y-auto space-y-2">
                <%= for {role_name, role_id} <- @all_roles do %>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <.input 
                      name="role_ids[]" 
                      type="checkbox" 
                      value={role_id}
                      class="h-4 w-4 rounded border-gray-300 text-[#1b629b] focus:ring-0" 
                    />
                    <span class="text-sm text-gray-700"><%= role_name %> (<%= role_id %>)</span>
                  </label>
                <% end %>
              </div>
              
              <div class="flex justify-end gap-3 mt-4">
                <button type="button" phx-click="close_modal" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-[#1b629b] hover:bg-[#155282] text-white rounded">Save Roles</button>
              </div>
            </.form>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>