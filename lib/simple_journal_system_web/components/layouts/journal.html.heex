<div class="min-h-screen bg-white flex flex-col justify-between">
  <div>
    <!-- Header Biru OJS -->
    <header class="bg-[#1b4e82] text-white px-8 py-6 shadow-inner">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <h1 class="text-3xl font-bold tracking-wide"><%= assigns[:journal_name] || "OJS" %></h1>
        <div class="text-sm space-x-4">
          <a href="#" class="hover:underline">Daftar</a>
          <a href="#" class="hover:underline">Login</a>
        </div>
      </div>

      <!-- Navigasi Menu -->
      <nav class="max-w-7xl mx-auto mt-6 flex space-x-8 text-sm font-medium border-b border-blue-900/40 pb-3">
  <a href={"/journals/#{@journal_name}/current"} class="text-blue-200 hover:text-white">Terkini</a>
  <a href={"/journals/#{@journal_name}/archive"} class="text-blue-200 hover:text-white">Arsip</a>
  <a href="#" class="text-blue-200 hover:text-white">Tentang Kami</a>
</nav>
    </header>

    <!-- Tempat Konten Utama (current / archive) Masuk -->
    <main class="max-w-7xl mx-auto px-8 py-6">
      <%= @inner_content %>
    </main>
  </div>

  <!-- Footer OJS -->
  <footer class="bg-[#e8e8e8] py-6 px-8 text-right text-gray-600 text-xs border-t">
    <div class="max-w-7xl mx-auto flex flex-col items-end">
      <p class="font-semibold text-gray-700">Platform & workflow by</p>
      <span class="font-serif italic text-xl tracking-tighter text-black font-bold">OJS / PKP</span>
    </div>
  </footer>
</div>