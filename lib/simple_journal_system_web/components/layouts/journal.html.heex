<div class="min-h-screen bg-white flex flex-col justify-between">
  <div>
    <!-- Header Biru OJS -->
    <header class="text-gray-800 px-8 py-2">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        
      </div>
      <!-- Navigasi Menu -->
      <nav class="max-w-7xl mx-auto mt-6 flex items-center space-x-6 text-gray-800 text-sm font-medium">
        <a href={~p"/journals/#{@journal_name}/current"} class="hover:underline">Terkini</a>
        <a href={~p"/journals/#{@journal_name}/archive"} class="hover:underline">Arsip</a>
        <!-- Dropdown Menu Tentang Kami -->
        <div class="relative group">
          <button
            type="button"
            class="hover:text-gray-200 font-medium inline-flex items-center focus:outline-none py-2"
          >
            <span>Tentang Kami</span>
            <svg
              class="w-4 h-4 ml-1 inline-block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            >
            </path></svg>
          </button>

          <div class="absolute left-0 top-full w-56 bg-white border border-gray-200 rounded-md shadow-lg hidden group-hover:block z-50">
            <div class="py-1 text-sm text-gray-700">
              <a
                href={~p"/journals/#{@journal_name}/about"}
                class="block px-4 py-2 hover:bg-gray-100"
              >Tentang Jurnal Ini</a>
              <a
                href={~p"/journals/#{@journal_name}/about/submissions"}
                class="block px-4 py-2 hover:bg-gray-100"
              >Penyerahan Naskah</a>
              <a
                href={~p"/journals/#{@journal_name}/about/editorialTeam"}
                class="block px-4 py-2 hover:bg-gray-100"
              >Masthead Editorial</a>
              <a
                href={~p"/journals/#{@journal_name}/about/privacy"}
                class="block px-4 py-2 hover:bg-gray-100"
              >Pernyataan Privasi</a>
              <a
                href={~p"/journals/#{@journal_name}/about/contact" |> String.replace("+", "")}
                class="block px-4 py-2 hover:bg-gray-100"
              >Kontak</a>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <!-- Tempat Konten Utama -->
    <main class="max-w-7xl mx-auto px-8 py-6">
      {@inner_content}
    </main>
  </div>
  <!-- Footer OJS -->
  <footer class="bg-[#e8e8e8] py-6 px-8 text-right text-gray-600 border-t">
    <div class="max-w-7xl mx-auto flex flex-col items-end">
      <p class="font-semibold text-gray-700">Platform & workflow by</p>
      <span class="font-serif italic text-xl tracking-tight text-gray-900">OJS / PKP</span>
    </div>
  </footer>
</div>
