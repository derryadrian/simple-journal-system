<Layouts.app flash={@flash}>
  <.header>
    Submission {@submission.submission_id}
    <:subtitle>This is a submission record from your database.</:subtitle>
    <:actions>
      <.button navigate={~p"/submissions"}>
        <.icon name="hero-arrow-left" />
      </.button>
      <.button variant="primary" navigate={~p"/submissions/#{@submission}/edit?return_to=show"}>
        <.icon name="hero-pencil-square" /> Edit submission
      </.button>
    </:actions>
  </.header>

   <.list>
    <:item title="Context ID">{@submission.context_id}</:item>
    <:item title="Stage ID">{@submission.stage_id}</:item>
    <:item title="Status">{@submission.status}</:item>
    <:item title="Locale">{@submission.locale}</:item>
    <:item title="Submission Progress">{@submission.submission_progress}</:item>
    <:item title="Work Type">{@submission.work_type}</:item>
  </.list>
</Layouts.app>
