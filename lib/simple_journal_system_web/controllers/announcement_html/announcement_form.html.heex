<.form
  :let={f}
  for={@changeset}
  action={@action}
  class="space-y-5 bg-white border border-gray-300 rounded p-6"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <.input
        field={f[:assoc_type]}
        type="number"
        label="Assoc Type"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:assoc_id]}
        type="number"
        label="Assoc ID"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:type_id]}
        type="number"
        label="Type ID"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:date_expire]}
        type="date"
        label="Date Expire"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:date_posted]}
        type="datetime-local"
        label="Date Posted"
        required
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>
  </div>

  <div class="flex items-center space-x-4 pt-4 border-t border-gray-200">
    <button
      type="submit"
      class="px-5 py-1.5 bg-[#1b629b] text-white font-semibold text-sm rounded border border-[#155080] shadow-sm transition-colors hover:bg-[#155080]"
    >
      Save
    </button>

    <.link
      href={@return_to}
      class="text-sm text-[#1b629b] hover:underline"
    >
      Cancel
    </.link>
  </div>
</.form>
