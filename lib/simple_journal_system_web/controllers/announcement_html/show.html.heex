<Layouts.app flash={@flash}>
  <div class="max-w-4xl mx-auto py-8 px-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Announcement Details</h1>
      <div class="flex space-x-3">
        <.link
          href={~p"/announcements/#{@announcement}/edit"}
          class="px-4 py-2 bg-[#1b629b] text-white rounded hover:bg-[#155080] text-sm font-medium"
        >
          Edit
        </.link>
        <.link
          href={~p"/announcements"}
          class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 text-sm font-medium"
        >
          Back to Announcements
        </.link>
      </div>
    </div>

    <div class="bg-white border border-gray-300 rounded p-6">
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="font-medium text-gray-700">ID</dt>
          <dd class="text-gray-900"><%= @announcement.announcement_id %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-700">Assoc Type</dt>
          <dd class="text-gray-900"><%= @announcement.assoc_type %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-700">Assoc ID</dt>
          <dd class="text-gray-900"><%= @announcement.assoc_id %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-700">Type ID</dt>
          <dd class="text-gray-900"><%= @announcement.type_id %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-700">Date Expire</dt>
          <dd class="text-gray-900"><%= @announcement.date_expire %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-700">Date Posted</dt>
          <dd class="text-gray-900"><%= @announcement.date_posted %></dd>
        </div>
      </dl>
    </div>
  </div>
</Layouts.app>
