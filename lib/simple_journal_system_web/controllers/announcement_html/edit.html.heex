<Layouts.app flash={@flash}>
  <div class="max-w-2xl mx-auto py-8 px-4">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Announcement</h1>

    <.announcement_form
      changeset={@changeset}
      action={~p"/announcements/#{@announcement}"}
      return_to={~p"/announcements"}
    />
  </div>
</Layouts.app>
