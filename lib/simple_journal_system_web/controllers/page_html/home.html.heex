<div class="min-h-screen bg-white flex flex-col justify-between font-sans text-gray-800">
  
  <!-- Header / Navbar Section -->
  <.ojs_header 
    current_scope={@current_scope} 
    current_journal={@current_journal}
    user_journals={@user_journals}
  />

  <!-- Main Content Area -->
  <main class="flex-grow max-w-5xl w-full mx-auto px-6 py-10">
    <div class="bg-white border-x border-gray-200 min-h-[500px]">
      
      <!-- Blank Top Section Spacer/Banner Area -->
      <div class="h-24 border-b border-gray-200"></div>

      <!-- Journal Item 1 -->
      <div class="p-8 border-b border-gray-200">
        <h2 class="text-lg font-bold text-[#1b629b] mb-3">
          bebas
        </h2>
        <div class="flex space-x-4 text-sm">
          <.link href="#" class="text-[#1b629b] hover:underline font-medium">
            View Journal
          </.link>
          <.link href="#" class="text-[#1b629b] hover:underline font-medium">
            Current Issue
          </.link>
        </div>
      </div>

      <!-- Journal Item 2 -->
      <div class="p-8 border-b border-gray-200">
        <h2 class="text-lg font-bold text-[#1b629b] mb-3">
          bebas2
        </h2>
        <div class="flex space-x-4 text-sm">
          <.link href="#" class="text-[#1b629b] hover:underline font-medium">
            View Journal
          </.link>
          <.link href="#" class="text-[#1b629b] hover:underline font-medium">
            Current Issue
          </.link>
        </div>
      </div>

    </div>
  </main>

  <!-- Footer Section -->
  <footer class="bg-[#dcdcdc] border-t border-gray-300 py-10 px-8">
    <div class="max-w-6xl mx-auto flex justify-end items-center">
      <div class="text-right text-gray-800">
        <p class="text-xl font-serif italic leading-tight">Platform &</p>
        <p class="text-xl font-serif italic leading-tight mb-1">workflow by</p>
        <p class="text-2xl font-serif font-bold tracking-tight">OJS / PKP</p>
      </div>
    </div>
  </footer>

</div>