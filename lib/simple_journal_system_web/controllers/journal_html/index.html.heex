<div class="min-h-screen bg-white flex flex-col">
  <!-- Main content -->
  <main class="flex-1">
    <div class="max-w-[1210px] mx-auto border-x border-gray-200">
      <!-- Empty OJS top area -->
      <div class="h-[78px] border-b border-gray-200"></div>

      <!-- Journal List -->
      <%= for journal <- @journals do %>
        <div class="min-h-[145px] border-b border-gray-200 px-8 py-10 flex justify-between items-center">
          <div>
            <h2 class="font-bold text-[#0875ad] text-base mb-4">
              {journal.name}
            </h2>

            <p class="text-gray-600 text-sm">
              Deskripsi singkat jurnal {journal.name}...
            </p>
          </div>

          <div class="flex gap-5 text-sm">
            <a
              href={~p"/journals/#{journal.slug}/current"}
              class="text-[#0875ad] hover:underline"
            >
              View Journal
            </a>

            <a
              href={~p"/journals/#{journal.slug}/current"}
              class="text-[#0875ad] hover:underline"
            >
              Current Issue
            </a>

            <a
              href={~p"/journals/#{journal.slug}/archive"}
              class="text-[#0875ad] hover:underline"
            >
              Archive
            </a>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-200">
    <div class="max-w-[1210px] mx-auto h-full flex justify-end items-end px-8 py-7">
      <div class="text-right">
        <p class="text-2xl leading-tight text-gray-800">
          Platform &<br /> workflow by
        </p>

        <p class="font-serif text-4xl leading-tight text-gray-900">
          OJS / PKP
        </p>
      </div>
    </div>
  </footer>
</div>
