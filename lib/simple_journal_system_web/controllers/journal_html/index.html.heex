<section class="max-w-7xl mx-auto px-4 py-8">
  <h2 class="text-2xl font-bold mb-6 text-gray-800">Daftar Jurnal</h2>
  
  <div class="space-y-4">
    <!-- Jurnal 1: bebas -->
    <div class="p-6 bg-white border rounded-lg shadow-sm flex justify-between items-center">
      <div>
        <h3 class="text-xl font-semibold text-blue-600">bebas</h3>
        <p class="text-gray-600 text-sm mt-1">Deskripsi singkat jurnal bebas...</p>
      </div>
      <div class="space-x-4 text-sm">
        <a href={~p"/journals/bebas/current"} class="text-blue-600 hover:underline font-medium">View Journal</a>
        <a href={~p"/journals/bebas/current"} class="text-blue-600 hover:underline font-medium">Current Issue</a>
        <a href={~p"/journals/bebas/archive"} class="text-gray-600 hover:underline font-medium">Archive</a>
      </div>
    </div>

    <!-- Jurnal 2: bebas2 -->
    <div class="p-6 bg-white border rounded-lg shadow-sm flex justify-between items-center">
      <div>
        <h3 class="text-xl font-semibold text-blue-600">bebas2</h3>
        <p class="text-gray-600 text-sm mt-1">Deskripsi singkat jurnal bebas2...</p>
      </div>
      <div class="space-x-4 text-sm">
        <a href={~p"/journals/bebas2/current"} class="text-blue-600 hover:underline font-medium">View Journal</a>
        <a href={~p"/journals/bebas2/current"} class="text-blue-600 hover:underline font-medium">Current Issue</a>
        <a href={~p"/journals/bebas2/archive"} class="text-gray-600 hover:underline font-medium">Archive</a>
      </div>
    </div>
  </div>
</section>