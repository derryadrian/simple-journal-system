<Layouts.app flash={@flash}>
  <div class="max-w-4xl mx-auto py-8 px-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Issues</h1>
      <.link
        href={~p"/issues/new"}
        class="px-4 py-2 bg-[#1b629b] text-white rounded hover:bg-[#155080] text-sm font-medium"
      >
        New Issue
      </.link>
    </div>

    <div class="bg-white border border-gray-300 rounded overflow-hidden">
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-100 text-gray-700">
          <tr>
            <th class="px-4 py-3 font-medium">ID</th>
            <th class="px-4 py-3 font-medium">Volume</th>
            <th class="px-4 py-3 font-medium">Number</th>
            <th class="px-4 py-3 font-medium">Year</th>
            <th class="px-4 py-3 font-medium">Published</th>
            <th class="px-4 py-3 font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= for issue <- @issues do %>
            <tr class="border-t border-gray-200 hover:bg-gray-50">
              <td class="px-4 py-3"><%= issue.issue_id %></td>
              <td class="px-4 py-3"><%= issue.volume %></td>
              <td class="px-4 py-3"><%= issue.number %></td>
              <td class="px-4 py-3"><%= issue.year %></td>
              <td class="px-4 py-3"><%= issue.published %></td>
              <td class="px-4 py-3 flex space-x-3">
                <.link href={~p"/issues/#{issue}"} class="text-[#1b629b] hover:underline">
                  Show
                </.link>
                <.link href={~p"/issues/#{issue}/edit"} class="text-[#1b629b] hover:underline">
                  Edit
                </.link>
                <.link
                  href={~p"/issues/#{issue}"}
                  method="delete"
                  data-confirm="Are you sure?"
                  class="text-red-600 hover:underline"
                >
                  Delete
                </.link>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</Layouts.app>
