<.form
  :let={f}
  for={@changeset}
  action={@action}
  class="space-y-5 bg-white border border-gray-300 rounded p-6"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <.input
        field={f[:journal_id]}
        type="number"
        label="Journal ID"
        required
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:volume]}
        type="number"
        label="Volume"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:number]}
        type="text"
        label="Number"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:year]}
        type="number"
        label="Year"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:published]}
        type="number"
        label="Published"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:access_status]}
        type="number"
        label="Access Status"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:show_volume]}
        type="number"
        label="Show Volume"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:show_number]}
        type="number"
        label="Show Number"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:show_year]}
        type="number"
        label="Show Year"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:show_title]}
        type="number"
        label="Show Title"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:style_file_name]}
        type="text"
        label="Style File Name"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:original_style_file_name]}
        type="text"
        label="Original Style File Name"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:url_path]}
        type="text"
        label="URL Path"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>

    <div>
      <.input
        field={f[:doi_id]}
        type="number"
        label="DOI ID"
        class="w-full px-3 py-1.5 border border-gray-400 rounded-sm text-sm focus:outline-none focus:border-[#1b629b] bg-white text-gray-900"
      />
    </div>
  </div>

  <div class="flex items-center space-x-4 pt-4 border-t border-gray-200">
    <button
      type="submit"
      class="px-5 py-1.5 bg-[#1b629b] text-white font-semibold text-sm rounded border border-[#155080] shadow-sm transition-colors hover:bg-[#155080]"
    >
      Save
    </button>

    <.link
      href={@return_to}
      class="text-sm text-[#1b629b] hover:underline"
    >
      Cancel
    </.link>
  </div>
</.form>
